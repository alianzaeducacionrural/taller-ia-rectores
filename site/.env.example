# local (por defecto): lee de src/data/instituciones/*.json, generado con
#   node scripts/generar-datos-locales.mjs
# sheets: lee cada institución en vivo desde su Google Sheet público (gviz),
#   usando los sheetId de src/data/mapaInstituciones.json — úsalo solo cuando
#   los 13 Sheets de producción ya existan y estén compartidos como
#   "cualquiera con el enlace: lector".
VITE_DATA_SOURCE=local

# URL /exec del Google Apps Script Web App que respalda /taller y
# /panel-facilitador (ver ../apps-script/Code.gs). Sin definir, ambas rutas
# caen a un modo de simulación en localStorage — útil para desarrollar y
# probar la UI, pero cada navegador ve solo sus propios envíos.
# VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXX/exec
